generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id
  email                 String                 @unique
  passwordHash          String
  name                  String
  role                  String
  /** 手机号（专家提现审核等后台展示） */
  phone                 String                 @default("")
  avatar                String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              Session[]
  expert                Expert?
  leads                 ConsultationLead[]
  auditLogs             AuditLog[]
  expertApplications    ExpertApplication[]
  realNameVerifications RealNameVerification[]
  certifications        ExpertCertification[]
  customOrdersAsBuyer   CustomOrder[]          @relation("OrderBuyer")
  customOrdersAsCreator CustomOrder[]          @relation("OrderCreator")
  privateInstances      PrivateAgentInstance[] @relation("InstanceCustomer")
  notifications         UserNotification[]
  wallet                Wallet?
  payments              PaymentRecord[]
  withdrawals           Withdrawal[]
  agentPurchases        AgentPurchase[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SiteSetting {
  key   String @id
  value String
}

model HomeBanner {
  id        String  @id
  slot      String
  eyebrow   String  @default("")
  title     String
  subtitle  String  @default("")
  ctaLabel  String  @default("")
  ctaTarget String  @default("")
  sortOrder Int     @default(0)
  visible   Boolean @default(true)
}

model Category {
  id        String  @id
  name      String
  sortOrder Int     @default(0)
  visible   Boolean @default(true)
}

model Agent {
  id              String   @id
  kind            String   @default("catalog")
  title           String
  desc            String
  category        String
  coverImage      String
  gradient        String   @default("")
  tagColor        String   @default("")
  badge           String?
  canFDECustom    Boolean  @default(true)
  authorId        String?
  authorName      String?
  price           Int?
  pricingPlans    String   @default("{}")
  likesCount      String   @default("0")
  favoritesCount  String   @default("0")
  commentsCount   String   @default("0")
  sharesCount     String   @default("0")
  /** 运营手动加成，前台展示 = 实际字段 + manual */
  likesManual     Int      @default(0)
  favoritesManual Int      @default(0)
  sharesManual    Int      @default(0)
  usageCount      String?
  rating          Float?
  status          String   @default("published")
  /** 创作者删除时间：软删，市场立即不可见，后台仍保留 */
  creatorDeletedAt DateTime?
  showOnHome      Boolean  @default(true)
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  solutionPayload String   @default("")
  /** 外部工具适配分发包：[{ platformName, fileName, url, size }] */
  adapterPackages String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  comments        AgentComment[]
  shareLinks      AgentShareLink[]
  purchases       AgentPurchase[]
  showcases       AgentShowcase[]
}

/** 分享链接：私有/已下架智能体凭 token 仍可访问 */
model AgentShareLink {
  id        String   @id
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([agentId])
}

/** 市场标准版购买：价格按下单时快照，后续改价不影响已购用户 */
model AgentPurchase {
  id            String    @id
  agentId       String
  agent         Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** one_time（历史数据可能为 monthly / annual / buyout，展示时均视为一次性） */
  plan          String
  priceCents    Int
  priceSnapshot String    @default("{}")
  /** pending | paid */
  status        String    @default("pending")
  channel       String    @default("")
  paymentId     String    @default("")
  paidAt        DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, agentId])
  @@index([agentId])
}

/** 用户上传的智能体使用成果；作者可精选或隐藏 */
model AgentShowcase {
  id         String   @id
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId     String
  userName   String
  userAvatar String   @default("")
  title      String   @default("")
  description String  @default("")
  imageUrl   String
  fileName   String   @default("")
  /** visible | hidden */
  status     String   @default("visible")
  featured   Boolean  @default(false)
  /** 发现灵感分类：视频 | 图片 | 网页 | 其他 */
  inspireCategory String @default("")
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([agentId, status])
  @@index([userId])
  @@index([featured, inspireCategory])
  comments    AgentComment[]
}

/** 评论：智能体详情或成果详情（source = agent | showcase） */
model AgentComment {
  id         String   @id
  agentId    String
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  /** agent | showcase */
  source     String   @default("agent")
  showcaseId String?
  showcase   AgentShowcase? @relation(fields: [showcaseId], references: [id], onDelete: Cascade)
  parentId   String?
  userId     String?
  userName   String
  userAvatar String   @default("")
  /** 是否为智能体作者的回复 */
  isAuthor   Boolean  @default(false)
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reports    AgentCommentReport[]

  @@index([agentId, source])
  @@index([showcaseId])
}

/** 用户对智能体评论的举报工单 */
model AgentCommentReport {
  id             String       @id
  commentId      String
  comment        AgentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  agentId        String
  /** agent | showcase，与评论来源一致 */
  source         String       @default("agent")
  showcaseId     String?
  reporterUserId String?
  reporterName   String       @default("")
  reason         String
  detail         String       @default("")
  /** pending | dismissed | removed */
  status         String       @default("pending")
  reviewerId     String?
  reviewNote     String       @default("")
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([commentId])
  @@index([agentId])
  @@index([source, status])
}

model Expert {
  id              String   @id
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  /** 对外展示编号，如 AI-EXP-000001 */
  expertNo        String   @default("")
  name            String
  avatar          String
  title           String
  verifyType      String
  verifyLabel     String
  expertLevel     Int      @default(1)
  roleTag         String   @default("")
  domainTags      String   @default("[]")
  rating          Float    @default(5)
  ordersCount     Int      @default(0)
  followersCount  Int      @default(0)
  praiseRate      Int      @default(100)
  responseTime    String   @default("")
  bio             String   @default("")
  location        String   @default("")
  serviceModes    String   @default("[]")
  guarantees      String   @default("[]")
  skills          String   @default("[]")
  stats           String   @default("{}")
  experienceYears Int      @default(0)
  featuredQuote   String   @default("")
  socialLinks     String   @default("{}")
  /** 非空时表示有待审核的主页资料变更 JSON：{ name, bio, domainTags } */
  pendingProfileSnapshot String @default("")
  listed          Boolean  @default(true)
  featured        Boolean  @default(false)
  paused          Boolean  @default(false)
  sortOrder       Int      @default(0)
  status          String   @default("active")
  /** 运营后台备注，不对前台展示 */
  adminNotes      String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  certification   ExpertCertification?
}

/** 平台统一维护的专家领域分类标签（上架才在前台展示/可选） */
model ExpertTag {
  id        String   @id
  name      String   @unique
  sortOrder Int      @default(0)
  /** active | offline */
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/** 平台统一维护的专家头衔（上架才可在入驻审核时选择，并展示在专家卡片） */
model ExpertTitle {
  id        String   @id
  name      String   @unique
  sortOrder Int      @default(0)
  /** active | offline */
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExpertCase {
  id       String @id
  expertId String
  payload  String
}

model ExpertReview {
  id       String @id
  expertId String
  payload  String
}

model ExpertService {
  id       String @id
  expertId String
  payload  String
}

model ConsultationLead {
  id             String   @id
  clientName     String
  clientCompany  String   @default("")
  clientAvatar   String   @default("")
  expertId       String?
  agentId        String   @default("")
  agentTitle     String   @default("")
  summary        String   @default("")
  contactPhone   String   @default("")
  budgetEstimate String   @default("")
  status         String   @default("new")
  notes          String   @default("")
  /** 运营跟进：未联系 / 已联系 */
  adminContactStatus String @default("uncontacted")
  /** 运营跟进备注，不对用户展示 */
  adminNotes     String   @default("")
  payload        String   @default("{}")
  assigneeId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  messages       ConsultationMessage[]
}

model ConsultationMessage {
  id         String           @id
  leadId     String
  lead       ConsultationLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender     String
  senderName String
  text       String
  createdAt  DateTime         @default(now())
}

model RealNameVerification {
  id             String    @id
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String    @default("unverified")
  provider       String    @default("mock")
  providerRef    String    @default("")
  /** 真实姓名（仅后台审核可见；前台仍用 realNameMasked） */
  realName       String    @default("")
  realNameMasked String    @default("")
  idCardMasked   String    @default("")
  /** 身份证正面 / 反面照片 URL（后台审核展示） */
  idCardFrontUrl String    @default("")
  idCardBackUrl  String    @default("")
  failReason     String    @default("")
  verifiedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ExpertApplication {
  id                       String    @id
  userId                   String
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                     String    @default("onboarding")
  status                   String    @default("pending")
  submittedProfileSnapshot String    @default("{}")
  realNameVerificationId   String?
  agreementVersion         String    @default("v1")
  agreementAcceptedAt      DateTime?
  reviewerId               String?
  reviewStartedAt          DateTime?
  reviewedAt               DateTime?
  decisionReason           String    @default("")
  supplementRequest        String    @default("")
  supplementSubmittedAt    DateTime?
  expertId                 String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model ExpertCertification {
  id                  String    @id
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expertId            String    @unique
  expert              Expert    @relation(fields: [expertId], references: [id], onDelete: Cascade)
  status              String    @default("active")
  sourceApplicationId String
  certifiedAt         DateTime
  frozenAt            DateTime?
  freezeReason        String    @default("")
  frozenBy            String?
  unfrozenAt          DateTime?
  unfrozenBy          String?
  updatedAt           DateTime  @updatedAt
}

model ExpertCertificationEvent {
  id               String   @id
  userId           String
  expertId         String?
  applicationId    String?
  certificationId  String?
  eventType        String
  actorId          String?
  fromStatus       String   @default("")
  toStatus         String   @default("")
  reason           String   @default("")
  payload          String   @default("{}")
  createdAt        DateTime @default(now())
}

model AuditLog {
  id         String   @id
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  diff       String   @default("{}")
  createdAt  DateTime @default(now())
}

/** 二次定制正式订单：绑定通用智能体当时版本 */
model CustomOrder {
  id                    String    @id
  orderNo               String    @unique
  /** consulting → awaiting_proposal_confirm → awaiting_payment → paid_pending_start → in_development → in_review → revision → pending_acceptance → pending_settlement → completed | closed */
  status                String    @default("consulting")
  buyerUserId           String
  buyer                 User      @relation("OrderBuyer", fields: [buyerUserId], references: [id])
  creatorUserId         String?
  creator               User?     @relation("OrderCreator", fields: [creatorUserId], references: [id])
  expertId              String?
  baseAgentId           String
  baseAgentTitle        String
  baseAgentVersion      String    @default("v1.0.0")
  title                 String
  customizationSpec     String    @default("{}")
  priceCents            Int       @default(0)
  currency              String    @default("CNY")
  deliveryDays          Int       @default(14)
  serviceScope          String    @default("")
  quoteNote             String    @default("")
  /** 结构化定制交付方案 JSON */
  deliveryProposal      String    @default("{}")
  proposalVersion       Int       @default(0)
  proposalSubmittedAt   DateTime?
  proposalConfirmedAt   DateTime?
  quotedAt              DateTime?
  paymentId             String    @default("")
  paymentStatus         String    @default("none")
  /** wechat | alipay */
  paymentChannel        String    @default("")
  paymentDeadlineAt     DateTime?
  paidAt                DateTime?
  escrowedAt            DateTime?
  acceptanceDeadlineAt  DateTime?
  acceptanceStartedAt   DateTime?
  /** 已发送的验收提醒标记 JSON，如 ["day1","day5","day7"] */
  acceptanceRemindersSent String @default("[]")
  revisionQuota         Int       @default(2)
  revisionsUsed         Int       @default(0)
  settlementStatus      String    @default("none")
  /** 验收后进入待结算，满此时刻才可自动结算（默认验收后 24h） */
  settlementEligibleAt  DateTime?
  platformFeeCents      Int       @default(0)
  creatorPayoutCents    Int       @default(0)
  settledAt             DateTime?
  /** none | open | continue_delivery | partial_refund | full_refund | confirmed_complete */
  disputeStatus         String    @default("none")
  disputeReason         String    @default("")
  disputeOpenedAt       DateTime?
  disputeResolvedAt     DateTime?
  /** none | processing | resolved */
  interventionStatus    String    @default("none")
  interventionReason    String    @default("")
  interventionAt        DateTime?
  closedAt              DateTime?
  closeReason           String    @default("")
  leadId                String?
  instanceId            String?
  currentDeliveryId     String?
  /** 运营跟进：未联系 / 已联系 */
  adminContactStatus    String    @default("uncontacted")
  /** 运营跟进备注 */
  adminNotes            String    @default("")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  instance              PrivateAgentInstance?
  deliveries            DeliveryVersion[]
  events                CustomOrderEvent[]
}

/** 客户专属智能体实例（不进公共市场） */
model PrivateAgentInstance {
  id                 String   @id
  orderId            String   @unique
  order              CustomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerUserId     String
  customer           User     @relation("InstanceCustomer", fields: [customerUserId], references: [id])
  creatorUserId      String
  expertId           String?
  baseAgentId        String
  baseAgentTitle     String
  baseAgentVersion   String
  title              String
  currentVersion     String   @default("")
  status             String   @default("draft")
  visibility         String   @default("customer_only")
  customizationSpec  String   @default("{}")
  publishedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deliveries         DeliveryVersion[]
}

/** 每一次交付审核版本（运营审的是版本，不是整单） */
model DeliveryVersion {
  id                 String   @id
  orderId            String
  order              CustomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  instanceId         String
  instance           PrivateAgentInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  version            String
  status             String   @default("draft")
  changelog          String   @default("")
  completedItems     String   @default("[]")
  skillPayload       String   @default("{}")
  hermesReport       String   @default("{}")
  hermesPassed       Boolean  @default(false)
  hermesCheckedAt    DateTime?
  submittedAt        DateTime?
  reviewerId         String?
  reviewedAt         DateTime?
  rejectReason       String   @default("")
  publishedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model CustomOrderEvent {
  id        String   @id
  orderId   String
  order     CustomOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId   String?
  eventType String
  fromStatus String  @default("")
  toStatus  String   @default("")
  reason    String   @default("")
  payload   String   @default("{}")
  createdAt DateTime @default(now())
}

model UserNotification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String   @default("")
  link      String   @default("")
  payload   String   @default("{}")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

/** 专家资金账户：待提现 / 可提现 */
model Wallet {
  id             String          @id
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingCents   Int             @default(0)
  availableCents Int             @default(0)
  frozenCents    Int             @default(0)
  wechatAccount  String          @default("")
  wechatBound    Boolean         @default(false)
  alipayAccount  String          @default("")
  alipayBound    Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  ledgers        WalletLedger[]
  withdrawals    Withdrawal[]
}

/** 资金流水：总收入记来源，提现记手续费 */
model WalletLedger {
  id                  String    @id
  walletId            String
  wallet              Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId              String
  /** income | withdrawal */
  type                String
  amountCents         Int
  feeCents            Int       @default(0)
  balanceAfterCents   Int
  channel             String    @default("")
  title               String
  /** agent = 智能体订单交易; custom = 定制订单交易 */
  sourceKind          String    @default("")
  sourceOrderNo       String    @default("")
  sourceBuyer         String    @default("")
  sourceAgent         String    @default("")
  relatedOrderId      String    @default("")
  relatedPaymentId    String    @default("")
  relatedWithdrawalId String    @default("")
  availableAt         DateTime?
  released            Boolean   @default(false)
  reversed            Boolean   @default(false)
  createdAt           DateTime  @default(now())
}

/** 定制订单支付单（微信 / 支付宝沙箱） */
model PaymentRecord {
  id           String    @id
  orderId      String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel      String
  amountCents  Int
  currency     String    @default("CNY")
  status       String    @default("pending")
  checkoutCode String    @default("")
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/** 专家收益提现 */
model Withdrawal {
  id          String    @id
  withdrawNo  String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId    String
  wallet      Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amountCents Int
  feeCents    Int       @default(0)
  channel     String
  account     String    @default("")
  /** pending → approved → paid | rejected | cancelled */
  status      String    @default("pending")
  reason      String    @default("")
  paidNote    String    @default("")
  reviewedBy  String    @default("")
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

/** 全局资金 / 结算规则（单例 id=default） */
model FinanceSettings {
  id                  String   @id @default("default")
  /** 托底平台服务费率，万分比：1000 = 10% */
  fallbackFeeRateBps  Int      @default(1000)
  /** 交付推送后用户验收天数，到期未确认则自动验收 */
  acceptanceDays      Int      @default(7)
  /** 验收后观察期（小时），满后可结算释放 */
  settlementHoldHours Int      @default(24)
  /** 待提现 → 可提现冻结天数（自进入待验收起算） */
  pendingHoldDays     Int      @default(7)
  updatedAt           DateTime @updatedAt
}

/**
 * 分时段平台服务费率。区间 [startAt, endAt) 左闭右开，启用时段禁止重叠。
 * 结算取费率时优先匹配「支付成功时间」落入的时段，否则用托底费率。
 */
model PlatformFeeRatePeriod {
  id        String   @id
  startAt   DateTime
  endAt     DateTime
  /** 万分比：1000 = 10% */
  rateBps   Int
  note      String   @default("")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, startAt, endAt])
}

/** 平台财务科目（对账：收入 / 支出） */
model FinanceAccount {
  id           String               @id
  code         String               @unique
  name         String
  /** income | expense */
  type         String
  balanceCents Int                  @default(0)
  sortOrder    Int                  @default(0)
  enabled      Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  entries      FinanceLedgerEntry[]
}

/** 平台财务凭证（一笔业务对应一个流水号，下挂多科目分录） */
model FinanceJournal {
  id                  String               @id
  flowNo              String               @unique
  /** 幂等键，如 escrow:orderId / settle:orderId / wd_req:withdrawId */
  idempotencyKey      String               @unique
  bizType             String
  bizOrderNo          String               @default("")
  operationType       String               @default("")
  relatedOrderId      String               @default("")
  relatedPaymentId    String               @default("")
  relatedWithdrawalId String               @default("")
  operatorId          String               @default("")
  operatorName        String               @default("")
  remark              String               @default("")
  createdAt           DateTime             @default(now())
  entries             FinanceLedgerEntry[]
}

/** 科目变动明细（对账行） */
model FinanceLedgerEntry {
  id               String         @id
  journalId        String
  journal          FinanceJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  flowNo           String
  accountId        String
  account          FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /** 正数增加科目余额，负数减少 */
  amountCents      Int
  balanceAfterCents Int
  bizOrderNo       String         @default("")
  bizType          String         @default("")
  operationType    String         @default("")
  createdAt        DateTime       @default(now())

  @@index([flowNo])
  @@index([bizOrderNo])
  @@index([accountId, createdAt])
  @@index([createdAt])
  @@index([bizType])
}
